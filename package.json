{
  "name": "media-project-manager",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "cross-env NODE_ENV=development concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "pnpm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.squievreux.mpm",
    "productName": "Media Project Manager",
    "copyright": "Copyright © 2026 Quievreux",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "msi"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "shortcutName": "Media Project Manager",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@squievreux/ui": "^0.1.1",
    "adm-zip": "^0.5.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "7.0.3",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  }
}